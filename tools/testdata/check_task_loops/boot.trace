# Synthetic successful boot; the start task creates the firmware tasks.
000000000000 0000000000 BOOT main
000000000000 0000000000 CREATE start prio=5
000000000000 0000000000 SCHEDULER start
000000000000 0000000000 CREATE IDLE prio=0
000000000000 0000000000 CREATE Tmr Svc prio=6
000000000000 0000000000 IN Tmr Svc
000000000000 0000000000 IN start
000000000000 0000000000 CREATE radio prio=4
000000000000 0000000000 CREATE input prio=3
000000000000 0000000000 CREATE ui prio=1
000000000000 0000000000 CREATE host prio=3
000000000000 0000000000 IN radio
000000000000 0000000000 IN input
000000000000 0000000000 IN host
000000000000 0000000000 IN ui
000000000000 0000000000 END virtual time limit (watchdog feeds 2)
