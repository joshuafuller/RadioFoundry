// SPI1 data flash, chip select PD7 (boards/uv380_family/pins.h; peripherals/spinor.cs).
// emu_check replaces {image} with this run's image and passes the template as $flashrepl.

spiNor: SPI.SpiNor @ spi1
    imageFile: "{image}"

gpioPortD:
    7 -> spiNor@0
