// SPDX-License-Identifier: MIT
// Copyright (c) 2026 The RadioFoundry Authors
// DM-1701 wiring: docs/spec/hardware-dm1701.md sections 1, 2, 5, 9, 11 and 13.
// The ADC and LCD share the existing models' interfaces (boards/uv380_family/power_uvf.c, display_uvf.c).

using "platforms/cpus/stm32f4.repl"

sram:
    size: 0x20000

flash:
    size: 0x100000

ccm: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x10000

bkpsram: Memory.MappedMemory @ sysbus 0x40024000
    size: 0x1000

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 72000000

adc1: RadioFoundry.Stm32Adc @ sysbus 0x40012000

// The W25Q128 data flash on SPI1, chip select PD7 (peripherals/spinor.cs SPI.SpiNor), is not declared here: its
// constructor needs the path of this run's flash image. dm1701.resc loads it from $flashrepl, the dm1701.flash.repl
// template that tools/emu/emu_check.py fills in with the image it builds. No measured calibration or codec is supplied.

rf: I2C.At1846s @ i2c3 0x2E

fsmcBank1: @none
lcd: RadioFoundry.St7735Lcd @ sysbus 0x60000000

// The HR_C6000 DMR baseband (peripherals/c6000.cs Hrc6000; hardware-dm1701.md 2, 4.1-4.3). Voice port on SPI2 with
// chip select PB12. Configuration port bit-banged: CS PE2, CLK PE3, MOSI PE4, MISO PE5. Power-down PE6. Interrupts,
// active low, on PC0 (timeslot), PC1 (system) and PC2 (RF TX), which go on to EXTI0-2. misoPort / misoPin: MISO
// shares port E with the clock, so the model sets it again before each read of that port's IDR (c6000.cs
// InstallMisoHook)
c6000: RadioFoundry.Hrc6000 @ spi2
    misoPort: gpioPortE
    misoPin: 5
    misoIdr: 0x40021010
    Miso -> gpioPortE@5
    TsInt -> gpioPortC@0
    SysInt -> gpioPortC@1
    RfTxInt -> gpioPortC@2

gpioPortB:
    12 -> c6000@4

// EXTI0-2 from port C only. The stock repl ties pin n of every port to EXTI n and ORs them, so PE0 and PE1 (the
// LEDs) or PD2 (a keypad row) held high masked the chip's interrupts on PC0-PC2. The firmware selects port C for
// them in SYSCFG EXTICR1, which Renode's EXTI model ignores. Each pin below goes to the sink instead, which replaces
// its EXTI link (stm32_stubs.cs GpioSink, as in md380.repl). Port A pins 0-2 and port B pins 0-1 already go to timers in
// the stock repl; port I pins 0 and 2 too
exti012Sink: RadioFoundry.GpioSink

gpioPortB:
    2 -> exti012Sink@0

gpioPortD:
    0 -> exti012Sink@1
    1 -> exti012Sink@2
    2 -> exti012Sink@3
    6 -> lcd@0
    13 -> lcd@1

gpioPortE:
    0 -> exti012Sink@4
    1 -> exti012Sink@5
    2 -> c6000@0
    3 -> c6000@1
    4 -> c6000@2
    6 -> c6000@3

gpioPortF:
    [0-2] -> exti012Sink@[6-8]

gpioPortG:
    [0-2] -> exti012Sink@[9-11]

gpioPortH:
    [0-2] -> exti012Sink@[12-14]

gpioPortI:
    1 -> exti012Sink@15

gpioPortJ:
    [0-2] -> exti012Sink@[16-18]

gpioPortK:
    [0-2] -> exti012Sink@[19-21]

// Replace the stock init's network SVD download; keep its reset tags. SVD names only annotate diagnostics.
sysbus:
    init:
        Tag <0x40021000, 0x40021003> "GPIOE_MODER" 0xFFFFFFFF
        Tag <0x40021004, 0x40021007> "GPIOE_OTYPER" 0x00000008
        Tag <0x50000010, 0x5000003f> "USB:RESET" 0x80000000
